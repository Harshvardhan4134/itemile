rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.role == 'admin' ||
         request.auth.token.role == 'moderator' ||
         request.auth.token.email in [
           'rentshare11@gmail.com', 
           'admin@rentshare.com',
           'gharsha238@gmail.com'
         ]);
    }
    
    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles
      allow read: if request.auth != null;
      
      // Users can create their own profile
      allow create: if request.auth != null && request.auth.uid == userId;
      
      // CRITICAL: Admins can update ANY field including 'verified'
      allow update: if isAdmin();
      
      // Users can update their own profile (except verification fields)
      allow update: if request.auth != null && 
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['verified', 'verificationStatus', 'verifiedAt', 'kycExempt', 'kycRequiredDocKeys']);
      
      // Users can submit KYC documents
      allow update: if request.auth != null && 
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['aadharFrontUrl', 'aadharBackUrl', 'panUrl', 'selfieUrl', 
                    'verificationStatus', 'submittedAt', 'rejectionReason']);
      
      // Users can update their own access status when granted access
      allow update: if request.auth != null && 
        request.auth.uid == userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['hasAccess', 'accessGrantedAt']);
    }
    
    // Referral codes: code string -> uid (single-doc lookup for signup validation)
    match /referralCodes/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null &&
        request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }
    
    // Access Codes collection - for waitlist management
    match /accessCodes/{codeId} {
      // Authenticated users can read access codes to verify them
      allow read: if request.auth != null;
      
      // Only admins can create, update, or delete access codes
      allow create, update, delete: if isAdmin();
    }
    
    // Email notifications
    match /email_notifications/{notificationId} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }
    
    // Notifications
    match /notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
    }
    
    // Listings - allow public read access for browsing, but authenticated users for writes
    match /listings/{listingId} {
      // Allow public read access so users can browse items without logging in
      allow read: if true;
      allow create: if request.auth != null;
      // Owners can update their own listings (except moderation fields)
      allow update: if request.auth != null && 
        resource.data.ownerId == request.auth.uid &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['moderation', 'softDeleted']);
      // Admins can update any listing (including moderation fields)
      allow update: if isAdmin();
      // Anyone authenticated can update to add likes/comments
      allow update: if request.auth != null;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    
    // Transactions (Bookings)
    match /transactions/{transactionId} {
      // Allow reading if user is a participant OR admin
      allow read: if request.auth != null && 
        (isAdmin() ||
         resource.data.ownerId == request.auth.uid || 
         resource.data.renterId == request.auth.uid);
      // Allow querying transactions - admins can list all, others can list for availability checks
      allow list: if request.auth != null;
      // Allow creating bookings
      // - Standard flow: renter creates (auth == renterId)
      // - Request-response flow: owner (responder) creates on behalf of requester (auth == ownerId)
      allow create: if request.auth != null &&
        (request.auth.uid == request.resource.data.renterId ||
         request.auth.uid == request.resource.data.ownerId);
      // Allow updating bookings - owner or renter can update
      allow update: if request.auth != null && 
        (resource.data.ownerId == request.auth.uid || 
         resource.data.renterId == request.auth.uid);
      
      // Handover Media subcollection - admin only for reading, participants can upload
      match /handoverMedia/{mediaId} {
        // Only admins can read handover media (for dispute resolution)
        allow read: if isAdmin();
        // Owner and renter can upload media during pickup/return
        // We check the parent transaction to verify user is a participant
        allow create: if request.auth != null && 
          (get(/databases/$(database)/documents/transactions/$(transactionId)).data.ownerId == request.auth.uid || 
           get(/databases/$(database)/documents/transactions/$(transactionId)).data.renterId == request.auth.uid) &&
          request.resource.data.uploadedBy == request.auth.uid;
      }
    }
    
    // Chats
    match /chats/{chatId} {
      // Allow read access if user is a participant in the chat
      // OR if user is owner/renter of the associated transaction
      allow read: if request.auth != null && (
        request.auth.uid in resource.data.participants ||
        (resource.data.transactionId != null && (
          get(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/transactions/$(resource.data.transactionId)).data.renterId == request.auth.uid
        ))
      );
      
      // Allow create if user is one of the participants being added
      allow create: if request.auth != null && 
        request.auth.uid in request.resource.data.participants;
      
      // Allow update if user is a participant in the chat
      allow update: if request.auth != null && 
        request.auth.uid in resource.data.participants;
        
      match /messages/{messageId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Reviews
    match /reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && resource.data.reviewerId == request.auth.uid;
    }

    // Requests: users can create and read requests, update their own requests
    match /requests/{requestId} {
      // Anyone can read requests (for the public feed)
      allow read: if request.auth != null;
      
      // Users can create their own requests
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      
      // Users can update their own requests or if they're responding to it
      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.userId ||
         request.auth.uid == request.resource.data.matchedWith);
      
      // Anyone authenticated can update to add likes/comments
      allow update: if request.auth != null;
      
      // Only request creator can delete their requests
      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.userId;
    }
    
    // Reports - admin/moderator only
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }
    
    // Admin actions - audit log, admin/moderator only
    match /admin_actions/{actionId} {
      allow create, read: if isAdmin();
    }
    
    // Message Posts - social media style posts
    match /messagePosts/{postId} {
      // Anyone can read message posts (including comments and likes) - public access
      allow read: if true;
      
      // Users can create their own message posts
      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.userId;
      
      // Users can update their own posts (for editing)
      // Anyone authenticated can update to add likes/comments
      allow update: if request.auth != null;
      
      // Users can delete their own posts
      allow delete: if request.auth != null &&
        resource.data.userId == request.auth.uid;
    }
  }
}
