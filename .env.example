# =============================================================================
# Itemile — environment variables (copy to .env and fill in)
# Do NOT use Lendlly / rentshare-5c5eb credentials for Itemile.
# =============================================================================

# --- Firebase (Console → Project settings → Your apps → Web app config) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: OAuth client ID override for Google sign-in popup
VITE_FIREBASE_GOOGLE_CLIENT_ID=

# Comma-separated admin emails (optional UI hint; access uses JWT claims)
VITE_ADMIN_EMAILS=

# Set true only when running Firebase emulators locally
VITE_USE_FIREBASE_EMULATORS=false

# --- App ---
VITE_APP_URL=http://localhost:5173

# --- Google Maps (US region bias) ---
VITE_GOOGLE_MAPS_API_KEY=

# --- Cloudinary (create itemile_upload unsigned preset) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=itemile_upload

# --- Stripe (Phase 3 — leave empty for now) ---
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Client-side encryption for payout bank fields ---
VITE_ENCRYPTION_KEY=

# --- Legacy India payments (ignore until Stripe migration) ---
# VITE_RAZORPAY_KEY_ID=
